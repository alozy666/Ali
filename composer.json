{
  "name": "ali/life-os",
  "description": "Personal Life OS — نسخة الاستضافة المشتركة (بدون VPS)",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.1",
    "ext-pdo": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-curl": "*",
    "ext-sodium": "*",
    "anthropic-ai/sdk": "^1.0",
    "minishlink/web-push": "^9.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/src/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  }
}
