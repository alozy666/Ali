<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <title>تمييز الأنماط الهندسية - مستويات</title>
  <style>
    body {
      font-family: sans-serif;
      background-color: #f0f8ff;
      text-align: center;
      margin: 0;
      padding: 0;
    }
    h1 {
      color: #2c3e50;
      margin-top: 20px;
    }
    .shape {
      width: 60px;
      height: 60px;
      margin: 5px;
      border: 2px solid #ccc;
      display: inline-block;
    }
    .square { background-color: #e74c3c; }
    .circle { background-color: #2980b9; border-radius: 50%; }
    .triangle {
      width: 0;
      height: 0;
      border-left: 30px solid transparent;
      border-right: 30px solid transparent;
      border-bottom: 60px solid #27ae60;
      background: none;
    }
    .diamond { background-color: #8e44ad; transform: rotate(45deg); }
    .star {
      background-color: gold;
      clip-path: polygon(50% 0%, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%);
    }
    .rectangle { background-color: #34495e; width: 80px; height: 40px; }
    .heart {
      background-color: pink;
      width: 60px;
      height: 60px;
      position: relative;
      transform: rotate(-45deg);
    }
    .heart::before,
    .heart::after {
      content: "";
      background-color: pink;
      border-radius: 50%;
      width: 60px;
      height: 60px;
      position: absolute;
    }
    .heart::before { top: -30px; left: 0; }
    .heart::after { top: 0; left: 30px; }
    .slot {
      width: 60px;
      height: 60px;
      border: 2px dashed #bbb;
      background-color: #fff;
      display: inline-block;
      margin: 5px;
    }
    .slot.highlight { background-color: #fff8dc; border-color: #f39c12; }
    .slot.filled { border: 2px solid #2ecc71; }
    .hidden { display: none; }
    button {
      margin: 10px;
      padding: 10px 20px;
      font-size: 16px;
      cursor: pointer;
    }
  </style>
</head>
<body>
  <div id="main-content">
    <h1>🔷 أكمل النمط حسب المستوى 🔶</h1>
    <p id="level-info"></p>
    <div class="shapes" id="shape-bank"></div>
    <div id="dropzone" style="display: flex; justify-content: center; flex-direction: row-reverse; gap: 10px; padding: 10px; border: 2px dashed #ccc; border-radius: 10px; background-color: #fdfdfd; margin: 20px auto; width: fit-content;"></div>
    <button onclick="checkPattern()">تحقق من النمط</button>
    <button onclick="resetPattern()">مسح الكل</button>
    <button id="next-button" onclick="nextPattern()" style="display:none; background-color: #2ecc71; color: white; border: none;">التالي ➡️</button>
    <p id="feedback"></p>
    <p id="attempt-counter">عدد المحاولات: 0</p>
  </div>

  <div id="congrats-screen" class="hidden">
    <h1 style="margin-top: 50px; font-size: 28px; color: #27ae60;">🎉 تهانينا! لقد أنهيت جميع المستويات بنجاح!</h1>
    <button onclick="restartGame()" style="margin-top: 30px; padding: 15px 25px; font-size: 20px; background-color: #2980b9; color: white; border: none; border-radius: 10px; cursor: pointer;">🔁 إعادة البدء</button>
  </div>

  <audio id="success-sound" preload="auto"><source src="https://cdn.pixabay.com/download/audio/2022/03/15/audio_bf7d8adfd6.mp3" type="audio/mpeg"></audio>
  <audio id="error-sound" preload="auto"><source src="https://cdn.pixabay.com/download/audio/2021/10/25/audio_5ba3a2dce2.mp3" type="audio/mpeg"></audio>

  <script>
    const shapeLibrary = {
      square: '<div class="shape square" draggable="true" data-shape="square"></div>',
      circle: '<div class="shape circle" draggable="true" data-shape="circle"></div>',
      triangle: '<div class="shape triangle" draggable="true" data-shape="triangle"></div>',
      diamond: '<div class="shape diamond" draggable="true" data-shape="diamond"></div>',
      star: '<div class="shape star" draggable="true" data-shape="star"></div>',
      rectangle: '<div class="shape rectangle" draggable="true" data-shape="rectangle"></div>',
      heart: '<div class="shape heart" draggable="true" data-shape="heart"></div>'
    };

    function createPattern(length, blanks, placeBlanksAtEnd = true) {
      let baseShape = randomShape();
      let altShape = randomShape();
      while (altShape === baseShape) altShape = randomShape();
      const pattern = [];
      for (let i = 0; i < length; i++) {
        pattern.push(i % 2 === 0 ? baseShape : altShape);
      }
      const blankIndexes = new Set();
      if (placeBlanksAtEnd) {
        for (let i = pattern.length - 1; i >= 0 && blankIndexes.size < blanks; i--) {
          blankIndexes.add(i);
        }
      } else {
        while (blankIndexes.size < blanks) {
          const idx = Math.floor(Math.random() * pattern.length);
          blankIndexes.add(idx);
        }
      }
      blankIndexes.forEach(i => pattern[i] = null);
      return pattern;
    }

    function randomShape() {
      const shapes = Object.keys(shapeLibrary);
      return shapes[Math.floor(Math.random() * shapes.length)];
    }

    function generateEasyPattern() {
      const options = [
        ['circle', 'square'],
        ['heart', 'diamond'],
        ['triangle', 'rectangle'],
        ['star', 'square']
      ];
      const [a, b] = options[Math.floor(Math.random() * options.length)];
      const pattern = [a, b, a, b];
      pattern[pattern.length - 1] = null;
      return pattern;
    }

    function generateMediumPattern() {
      const options = [
        ['square', 'circle', 'triangle'],
        ['heart', 'diamond', 'rectangle'],
        ['star', 'rectangle', 'circle']
      ];
      const [a, b, c] = options[Math.floor(Math.random() * options.length)];
      const pattern = [a, b, c, a, b, c];
      pattern[4] = null;
      pattern[5] = null;
      return pattern;
    }

    function generateHardPattern() {
      const options = [
        ['circle', 'triangle', 'square', 'diamond'],
        ['rectangle', 'star', 'heart', 'square'],
        ['diamond', 'heart', 'triangle', 'star']
      ];
      const [a, b, c, d] = options[Math.floor(Math.random() * options.length)];
      const pattern = [a, b, c, d, a, b, c, d];
      const blankIndices = [4, 6, 7];
      blankIndices.forEach(i => pattern[i] = null);
      return pattern;
    }

    let levels = [];
    let currentLevelIndex = 0;
    let currentQuestionIndex = 0;
    let slots = [];
    let attempts = 0;

    function generateNewQuestions() {
      levels = [
        Array.from({ length: 2 }, (_, i) => {
          const pattern = generateEasyPattern();
          const delay = i * 100 + Math.floor(Math.random() * 50);
          for (let d = 0; d < delay; d++) randomShape();
          const usedShapes = Array.from(new Set(pattern.filter(Boolean)));
          return { pattern, shapes: usedShapes };
        }),
        Array.from({ length: 2 }, (_, i) => {
          const pattern = generateMediumPattern();
          const delay = i * 100 + Math.floor(Math.random() * 50);
          for (let d = 0; d < delay; d++) randomShape();
          const usedShapes = Array.from(new Set(pattern.filter(Boolean)));
          return { pattern, shapes: usedShapes };
        }),
        Array.from({ length: 2 }, (_, i) => {
          const pattern = generateHardPattern();
          const delay = i * 100 + Math.floor(Math.random() * 50);
          for (let d = 0; d < delay; d++) randomShape();
          const usedShapes = Array.from(new Set(pattern.filter(Boolean)));
          return { pattern, shapes: usedShapes };
        })
      ];
    }

    function renderShapes(allowedShapes) {
      const container = document.getElementById('shape-bank');
      container.innerHTML = '';
      allowedShapes.forEach(shape => {
        container.innerHTML += shapeLibrary[shape];
      });
      document.querySelectorAll('.shape').forEach(shape => {
        shape.addEventListener('dragstart', e => {
          e.dataTransfer.setData('shape', e.target.dataset.shape);
        });
      });
    }

    function loadQuestion() {
      const question = levels[currentLevelIndex][currentQuestionIndex];
      document.getElementById('level-info').textContent = `المستوى ${currentLevelIndex + 1} - سؤال ${currentQuestionIndex + 1}`;
      renderShapes(question.shapes);
      const dropzone = document.getElementById('dropzone');
      dropzone.innerHTML = '';
      slots = [];
      const reversedPattern = [...question.pattern].reverse();
      reversedPattern.forEach((value, i) => {
        const isEmpty = value === null;
        const slot = document.createElement('div');
        slot.className = isEmpty ? 'slot highlight' : 'slot';
        slot.ondragover = event => event.preventDefault();
        if (isEmpty) {
          slot.ondrop = event => drop(event, i);
        } else {
          const fixedShape = document.createElement('div');
          fixedShape.className = `shape ${value} clone`;
          fixedShape.draggable = false;
          slot.appendChild(fixedShape);
          slot.classList.add('filled');
        }
        dropzone.appendChild(slot);
        slots.push(slot);
      });
      document.getElementById('feedback').textContent = '';
      document.getElementById('next-button').style.display = 'none';
      document.getElementById('attempt-counter').textContent = 'عدد المحاولات: 0';
      attempts = 0;
    }

    function drop(event, index) {
      const shapeType = event.dataTransfer.getData('shape');
      const slot = slots[index];
      if (slot.hasChildNodes()) return;
      const newShape = document.createElement('div');
      newShape.className = `shape ${shapeType} clone`;
      newShape.dataset.shape = shapeType;
      newShape.draggable = false;
      slot.appendChild(newShape);
      slot.classList.add('filled');
    }

    function checkPattern() {
      const studentPattern = slots.map(slot => slot.firstChild ? slot.firstChild.dataset.shape : null);
      const correct = levels[currentLevelIndex][currentQuestionIndex].pattern;
      const feedback = document.getElementById('feedback');
      const successSound = document.getElementById('success-sound');
      const errorSound = document.getElementById('error-sound');

      if (studentPattern.includes(null)) {
        feedback.textContent = 'يرجى إكمال جميع الفراغات أولاً';
        feedback.style.color = 'orange';
        return;
      }

      const reversedCorrect = [...correct].reverse();
      const match = reversedCorrect.every((expected, i) => {
        return expected === null ? studentPattern[i] !== null && studentPattern[i] !== undefined : true;
      });

      document.getElementById('attempt-counter').textContent = `عدد المحاولات: ${++attempts}`;

      if (match) {
        feedback.textContent = 'أحسنت! الإجابة صحيحة ✅';
        feedback.style.color = 'green';
        document.getElementById('next-button').style.display = 'inline-block';
        if (successSound && successSound.play) successSound.play();
      } else {
        feedback.textContent = '❌ النمط غير صحيح. حاول مرة أخرى';
        feedback.style.color = 'red';
        if (errorSound && errorSound.play) errorSound.play();
      }
    }

    function resetPattern() {
      slots.forEach(slot => {
        if (slot.classList.contains('highlight')) {
          slot.innerHTML = '';
          slot.classList.remove('filled');
        }
      });
      document.getElementById('feedback').textContent = '';
      document.getElementById('next-button').style.display = 'none';
      document.getElementById('attempt-counter').textContent = 'عدد المحاولات: 0';
      attempts = 0;
    }

    function nextPattern() {
      currentQuestionIndex++;
      if (currentQuestionIndex >= levels[currentLevelIndex].length) {
        currentLevelIndex++;
        currentQuestionIndex = 0;
        if (currentLevelIndex >= levels.length) {
          document.getElementById('main-content').classList.add('hidden');
          document.getElementById('congrats-screen').classList.remove('hidden');
          return;
        }
      }
      loadQuestion();
    }

    function restartGame() {
      document.getElementById('main-content').classList.remove('hidden');
      document.getElementById('congrats-screen').classList.add('hidden');
      currentLevelIndex = 0;
      currentQuestionIndex = 0;
      generateNewQuestions();
      loadQuestion();
    }

    window.addEventListener('DOMContentLoaded', () => {
      generateNewQuestions();
      loadQuestion();
    });
  </script>
</body>
</html>
